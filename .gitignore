# Prototype data and outputs are large and regenerable
prototype/data/*
!prototype/data/.gitkeep
prototype/out/*
!prototype/out/.gitkeep
prototype/models/
.venv/
__pycache__/
*.pyc
*.parquet

# Android build output. Note: do NOT add a blanket *.xml rule here. An earlier version
# did, and it silently excluded AndroidManifest.xml and every resource file, which would
# have produced a repository that cannot build from a fresh clone.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/

# IDE state. Local to one machine: recent files, run targets and absolute paths.
.idea/
android/.idea/
*.iml

# Release artifacts and signing material. Signing reads its settings from the environment
# or from ~/.gradle/gradle.properties, never from the repository.
android/app/release/
*.aab
*.apk
*.jks
*.keystore
keystore.properties

.DS_Store

