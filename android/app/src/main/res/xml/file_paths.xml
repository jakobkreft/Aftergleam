<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the downloads directory is shared, and only for handing one file to a reader app.
  A download that is not a PDF cannot be rendered here, and a file URI cannot be passed to
  another app at all, so it goes out as a content URI scoped to this one folder.
-->
<paths>
    <files-path name="downloads" path="pdf/" />
    <!-- Where downloads were kept before 1.1.1, until each is moved to the line above. -->
    <cache-path name="cached-downloads" path="pdf/" />
    <!-- Copies named after the paper, for sending to somebody else. -->
    <cache-path name="shared" path="share/" />
</paths>
