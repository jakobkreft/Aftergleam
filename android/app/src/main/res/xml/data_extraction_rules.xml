<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later.

  Reading history and the model follow the reader to a new phone during the direct transfer,
  and never go to a cloud backup account. The app's promise is that nothing about what you read
  leaves the device, and a backup uploaded to someone else's server would break it quietly.
  Downloaded PDFs are in the app's files, which neither list includes: they can always be
  fetched again, and would make a transfer slow for nothing.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
