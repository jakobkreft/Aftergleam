<!--
  The paper the mark is printed on.

  Flat, so it stays a vector and costs one path at any density. The warm tone is the
  point: a drawer of icons is mostly white, black and saturated, and cream is not.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z" android:fillColor="#ECDCCD" />
</vector>
